# Корневой конфиг проекта: не искать lombok.config в родительских каталогах
config.stopBubbling = true

# Помечать сгенерированный Lombok код аннотацией @lombok.Generated:
# JaCoCo исключает такие методы из покрытия, а Sonar берёт покрытие из отчёта JaCoCo
lombok.addLombokGeneratedAnnotation = true

# Переносить @Qualifier с поля в параметр конструктора, сгенерированного @RequiredArgsConstructor
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
