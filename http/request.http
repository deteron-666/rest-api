###
# REST API request collection
#
# Как использовать в IntelliJ IDEA:
# 1. Запустите приложение (например, ./mvnw spring-boot:run).
# 2. Убедитесь, что сервер доступен по адресу http://localhost:8080.
# 3. Запускайте запросы по порядку, нажимая зелёный значок Run рядом с запросом.
#    Запросы создания сохраняют productId и orderId из ответа для следующих запросов.
# 4. Для другого адреса измените baseUrl ниже или выберите другой HTTP Client environment.
#
# Сценарий создания заказа требует сначала выполнить запрос создания товара.
# Отмена или удаление PENDING-заказа возвращает товар на склад; оплаченный заказ удалить нельзя (409).

@baseUrl = http://localhost:8080

### Получить список товаров
GET {{baseUrl}}/api/products
Accept: application/json

### Создать товар для сценария заказа
POST {{baseUrl}}/api/products
Content-Type: application/json
Accept: application/json

{
  "name": "Mechanical keyboard",
  "description": "Keyboard created from the HTTP client",
  "price": 79.50,
  "stockQuantity": 10
}

> {%
    client.global.set("productId", response.body.id);
    client.global.set("productVersion", response.body.version);
%}

### Получить товар по ID, сохранённому после создания
GET {{baseUrl}}/api/products/{{productId}}
Accept: application/json

### Обновить товар
# version из ответа на создание: если товар успели изменить (например, заказ списал остаток), будет 409
PUT {{baseUrl}}/api/products/{{productId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Updated mechanical keyboard",
  "description": "Updated from the HTTP client",
  "price": 84.90,
  "stockQuantity": 10,
  "version": {{productVersion}}
}

### Создать заказ на две единицы товара
# В ответе сохраняется orderId для следующих запросов.
POST {{baseUrl}}/api/orders
Content-Type: application/json
Accept: application/json

{
  "customerName": "Alex Smith",
  "items": [
    {
      "productId": {{productId}},
      "quantity": 2
    }
  ]
}

> {%
    client.global.set("orderId", response.body.id);
%}

### Получить заказ по ID, сохранённому после создания
GET {{baseUrl}}/api/orders/{{orderId}}
Accept: application/json

### Получить список заказов (общее количество в заголовке X-Total-Count)
GET {{baseUrl}}/api/orders?status=PENDING&page=0&size=20
Accept: application/json

### Поиск товаров: фильтры и пагинация
GET {{baseUrl}}/api/products?name=keyboard&minPrice=10&inStock=true&page=0&size=20
Accept: application/json

### Проверить остаток товара после создания заказа
GET {{baseUrl}}/api/products/{{productId}}
Accept: application/json

### Отчёт: топ товаров по выручке (по умолчанию PENDING и PAID заказы)
GET {{baseUrl}}/api/reports/product-sales?from=2020-01-01T00:00:00Z&limit=10
Accept: application/json

### Отчёт только по оплаченным заказам с выручкой от 100
GET {{baseUrl}}/api/reports/product-sales?status=PAID&minRevenue=100
Accept: application/json

### Отменить заказ (PENDING -> CANCELLED), товар возвращается на склад
POST {{baseUrl}}/api/orders/{{orderId}}/cancel
Accept: application/json

### Повторная оплата отменённого заказа (ожидается 409 Conflict)
POST {{baseUrl}}/api/orders/{{orderId}}/pay
Accept: application/json

### Удалить заказ
DELETE {{baseUrl}}/api/orders/{{orderId}}
Accept: application/json

### Создать и оплатить ещё один заказ
POST {{baseUrl}}/api/orders
Content-Type: application/json
Accept: application/json

{
  "customerName": "Alex Smith",
  "items": [
    {
      "productId": {{productId}},
      "quantity": 1
    }
  ]
}

> {%
    client.global.set("paidOrderId", response.body.id);
%}

###
POST {{baseUrl}}/api/orders/{{paidOrderId}}/pay
Accept: application/json

### Удалить оплаченный заказ (ожидается 409 Conflict)
DELETE {{baseUrl}}/api/orders/{{paidOrderId}}
Accept: application/json

### Удалить товар
DELETE {{baseUrl}}/api/products/{{productId}}
Accept: application/json

### Проверка валидации: некорректный товар (ожидается 400 Bad Request)
POST {{baseUrl}}/api/products
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "price": -1,
  "stockQuantity": -1
}

### Проверка наличия: неизвестный товар (ожидается 404 Not Found)
GET {{baseUrl}}/api/products/9223372036854775807
Accept: application/json

### Проверка бизнес-правила: заказ без позиций (ожидается 400 Bad Request)
POST {{baseUrl}}/api/orders
Content-Type: application/json
Accept: application/json

{
  "customerName": "Alex Smith",
  "items": []
}

### Проверка остатка: заказ больше, чем есть на складе (ожидается 409 Conflict)
POST {{baseUrl}}/api/orders
Content-Type: application/json
Accept: application/json

{
  "customerName": "Alex Smith",
  "items": [
    {
      "productId": {{productId}},
      "quantity": 10000
    }
  ]
}
